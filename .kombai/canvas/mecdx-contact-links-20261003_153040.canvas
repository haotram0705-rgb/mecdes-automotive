        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n.mec-contact-page{min-height:100vh;background:radial-gradient(ellipse at 74% 42%,rgba(28,35,38,.28),transparent 38%),#070809;color:#f2f2ef;font-family:'Inter',Arial,sans-serif;position:relative;overflow:hidden}\n.mec-contact-header{height:80px;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(7,8,9,.96),rgba(7,8,9,.72));position:absolute;top:0;left:0;right:0;z-index:3;backdrop-filter:blur(12px)}\n.mec-contact-brand{font:700 24px/1 'Space Grotesk',sans-serif;letter-spacing:-1px;color:#f2f2ef;text-decoration:none}.mec-contact-brand span{color:#d9ff3f}\n.mec-contact-nav{display:flex;align-items:center;gap:34px;margin-left:70px}.mec-contact-nav a{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#9da2a4;text-decoration:none}.mec-contact-nav a:last-child{color:#d9ff3f}\n.mec-compare{border:1px solid rgba(255,255,255,.17);border-radius:999px;background:rgba(8,10,10,.58);color:#e8ebe6;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}\n.mec-drive-shell{max-width:1260px;margin:0 auto;padding:176px 28px 138px;min-height:100vh;display:flex;align-items:center}\n.mec-drive-layout{width:100%;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:start;gap:82px}\n.mec-drive-intro{padding-top:0}\n.mec-drive-title{font:600 clamp(78px,8.3vw,116px)/.84 'Space Grotesk',sans-serif;letter-spacing:-.075em;margin:0;color:#f5f5f2;max-width:560px}\n.mec-drive-copy{margin:34px 0 0;max-width:370px;color:#8f9598;font-size:13px;line-height:1.8}\n.mec-booking-combo{display:grid;grid-template-columns:minmax(0,1fr) 176px;align-items:start;gap:30px;padding-top:4px}\n.mec-booking-form{min-width:0}\n.mec-form-field{margin:0 0 20px}\n.mec-form-label{display:block;margin:0 0 9px;color:#858b8e;font-size:9px;line-height:1;letter-spacing:.19em;text-transform:uppercase}\n.mec-input,.mec-select{display:block;width:100%;height:50px;border:1px solid #292e31;border-radius:0;background:#101315;color:#f2f2ef;padding:0 14px;font:400 14px 'Inter',sans-serif;outline:none;box-shadow:none}\n.mec-input::placeholder{color:#858b8e;opacity:1}\n.mec-input:focus,.mec-select:focus{border-color:#6c7477}\n.mec-date-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.mec-submit{width:100%;height:48px;margin-top:1px;padding:0 18px;border:1px solid #d9ff3f;border-radius:0;background:#d9ff3f;color:#080909;display:flex;align-items:center;justify-content:space-between;font:700 9px 'Inter',sans-serif;letter-spacing:.15em;text-transform:uppercase}\n.mec-submit .fa-arrow-right{font-size:13px}\n.mec-form-note{margin:11px 0 0;color:#696f71;text-align:center;font-size:9px;line-height:1.6}\n.mec-contact-rail{border-left:1px solid #292d30;padding:0 0 0 23px;margin-top:1px;min-width:0}\n.mec-contact-question{margin:0 0 9px;color:#e8ebe7;font:600 16px/1.35 'Space Grotesk',sans-serif;letter-spacing:-.02em}\n.mec-contact-context{margin:0 0 24px;color:#777e80;font-size:10px;line-height:1.65}\n.mec-contact-list{display:grid;grid-template-columns:1fr}\n.mec-contact-row{min-height:62px;padding:11px 0 10px;border-bottom:1px solid rgba(255,255,255,.1);display:grid;grid-template-columns:24px minmax(0,1fr);column-gap:9px;align-items:start;color:#f2f2ef}\n.mec-contact-row:first-child{border-top:1px solid rgba(255,255,255,.1)}\n.mec-contact-icon{width:18px;height:18px;display:flex;align-items:center;justify-content:flex-start;padding-top:2px;color:#dfe3df;font-size:15px}\n.mec-contact-name{display:block;color:#e6e9e5;font-size:11px;font-weight:600;line-height:1.25}\n.mec-contact-status{display:block;margin-top:5px;color:#747b7d;font-size:9px;line-height:1.2}\n.mec-contact-note{margin:15px 0 0;color:#777e80;font-size:9px;line-height:1.65}\n.mec-audio-presence{position:fixed;bottom:22px;left:22px;z-index:4;display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.12);border-radius:999px;background:rgba(7,9,9,.82);padding:10px 14px;color:#aab0ac;font-size:8px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}\n.mec-audio-presence strong{color:#d9ff3f;font-weight:700}\n@media(max-width:1050px){.mec-drive-shell{padding:145px 6vw 105px}.mec-drive-layout{grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:48px}.mec-drive-title{font-size:clamp(68px,8vw,96px)}.mec-booking-combo{grid-template-columns:minmax(0,1fr) 164px;gap:20px}.mec-contact-rail{padding-left:18px}}\n@media(max-width:820px){.mec-contact-header{height:70px;padding:0 22px}.mec-contact-nav{display:none}.mec-drive-shell{min-height:auto;padding:125px 26px 100px}.mec-drive-layout{grid-template-columns:1fr;gap:34px}.mec-drive-intro{max-width:580px}.mec-drive-title{font-size:clamp(66px,12vw,94px)}.mec-drive-copy{margin-top:19px}.mec-booking-combo{grid-template-columns:1fr;gap:26px;padding-top:0}.mec-contact-rail{grid-row:1;border-left:0;border-top:1px solid #292d30;padding:17px 0 0;margin:0}.mec-contact-question{font-size:15px;margin-bottom:5px}.mec-contact-context{margin-bottom:11px}.mec-contact-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.mec-contact-row{min-height:55px;border:0;padding:8px 0;grid-template-columns:19px minmax(0,1fr);column-gap:6px}.mec-contact-row:first-child{border-top:0}.mec-contact-icon{font-size:14px;width:16px}.mec-contact-name{font-size:10px}.mec-contact-status{font-size:8px;margin-top:4px}.mec-contact-note{margin-top:8px}.mec-booking-form{grid-row:2}}\n@media(max-width:520px){.mec-drive-shell{padding:112px 20px 90px}.mec-drive-layout{gap:27px}.mec-drive-title{font-size:clamp(58px,14vw,76px)}.mec-drive-copy{font-size:12px;line-height:1.7}.mec-contact-list{gap:4px}.mec-contact-row{grid-template-columns:15px minmax(0,1fr);column-gap:5px}.mec-contact-icon{font-size:13px;width:14px}.mec-contact-name{font-size:9px}.mec-contact-status{font-size:7px}.mec-input,.mec-select{height:47px;font-size:13px}.mec-audio-presence{bottom:13px;left:13px}}\n</style>\n<div class=\"mec-contact-page\" data-kid=\"1\" data-name=\"contact page container\">\n    <header class=\"mec-contact-header\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a class=\"mec-contact-brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            MECDEX\n            <span data-kid=\"1-1-1-1\" data-name=\"brand dot icon\">\n                .\n            </span>\n        </a>\n        <nav aria-label=\"Điều hướng chính\" class=\"mec-contact-nav\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <a data-kid=\"1-1-2-1\" data-name=\"about link\" href=\"#\">\n                About\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"models link\" href=\"#\">\n                Models\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"configurator link\" href=\"#\">\n                Configurator\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"360 studio link\" href=\"#\">\n                360° Studio\n            </a>\n            <a data-kid=\"1-1-2-5\" data-name=\"test drive link\" href=\"#\">\n                Test Drive\n            </a>\n        </nav>\n        <div class=\"mec-compare\" data-kid=\"1-1-3\" data-name=\"compare button\">\n            COMPARE\n            <span data-kid=\"1-1-3-1\" data-name=\"compare count value\" style=\"color:#d9ff3f\">\n                0\n            </span>\n        </div>\n    </header>\n    <main class=\"mec-drive-shell\" data-kid=\"1-2\" data-name=\"main content container\">\n        <section aria-labelledby=\"mec-drive-heading\" class=\"mec-drive-layout\" data-kid=\"1-2-1\" data-name=\"drive booking layout\">\n            <div class=\"mec-drive-intro\" data-kid=\"1-2-1-1\" data-name=\"intro section\">\n                <h1 class=\"mec-drive-title\" data-kid=\"1-2-1-1-1\" data-name=\"page headline\" id=\"mec-drive-heading\">\n                    Take the\n                    <br data-kid=\"1-2-1-1-1-1\" data-name=\"line break\"/>\n                    wheel.\n                </h1>\n                <p class=\"mec-drive-copy\" data-kid=\"1-2-1-1-2\" data-name=\"intro copy\">\n                    Đặt lịch lái thử riêng tại showroom MECDEX.\n                </p>\n            </div>\n            <div class=\"mec-booking-combo\" data-kid=\"1-2-1-2\" data-name=\"booking form section\">\n                <form class=\"mec-booking-form\" data-kid=\"1-2-1-2-1\" data-name=\"test drive booking form\">\n                    <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-1\" data-name=\"name field container\">\n                        <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"name field label\" for=\"drive-name\">\n                            HỌ VÀ TÊN\n                        </label>\n                        <input autocomplete=\"name\" class=\"mec-input\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"name input field\" id=\"drive-name\" name=\"name\" placeholder=\"Nguyễn Văn A\" required=\"\"/>\n                    </div>\n                    <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-2\" data-name=\"phone field container\">\n                        <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"phone field label\" for=\"drive-phone\">\n                            SỐ ĐIỆN THOẠI\n                        </label>\n                        <input autocomplete=\"tel\" class=\"mec-input\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"phone input field\" id=\"drive-phone\" name=\"phone\" required=\"\" type=\"tel\"/>\n                    </div>\n                    <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-3\" data-name=\"car model field container\">\n                        <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"car model field label\" for=\"drive-model\">\n                            MẪU XE\n                        </label>\n                        <select class=\"mec-select\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"car model select menu\" id=\"drive-model\" name=\"model\">\n                            <option data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"apex x1 option\">\n                                APEX X1\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"veloce r option\">\n                                VELOCE R\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-3\" data-name=\"noir gt option\">\n                                NOIR GT\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-4\" data-name=\"c-class option\">\n                                C-Class\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-5\" data-name=\"e-class option\">\n                                E-Class\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-6\" data-name=\"s-class option\">\n                                S-Class\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-7\" data-name=\"eqs saloon option\">\n                                EQS Saloon\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-8\" data-name=\"glc option\">\n                                GLC\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-9\" data-name=\"gle option\">\n                                GLE\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-10\" data-name=\"gls option\">\n                                GLS\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-11\" data-name=\"g-class option\">\n                                G-Class\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-12\" data-name=\"amg gt coupe option\">\n                                AMG GT Coupé\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-13\" data-name=\"macan option\">\n                                Macan\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-14\" data-name=\"macan s option\">\n                                Macan S\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-15\" data-name=\"macan gts option\">\n                                Macan GTS\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-16\" data-name=\"718 cayman option\">\n                                718 Cayman\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-17\" data-name=\"taycan option\">\n                                Taycan\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-3-2-18\" data-name=\"911 spirit 70 option\">\n                                911 Spirit 70\n                            </option>\n                        </select>\n                    </div>\n                    <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-4\" data-name=\"showroom field container\">\n                        <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"showroom field label\" for=\"drive-showroom\">\n                            SHOWROOM\n                        </label>\n                        <select class=\"mec-select\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"showroom select menu\" id=\"drive-showroom\" name=\"showroom\">\n                            <option data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"hcm showroom option\">\n                                TP. Hồ Chí Minh\n                            </option>\n                            <option data-kid=\"1-2-1-2-1-4-2-2\" data-name=\"hanoi showroom option\">\n                                Hà Nội\n                            </option>\n                        </select>\n                    </div>\n                    <div class=\"mec-date-row\" data-kid=\"1-2-1-2-1-5\" data-name=\"date and time row\">\n                        <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-5-1\" data-name=\"date field container\">\n                            <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-5-1-1\" data-name=\"date field label\" for=\"drive-date\">\n                                NGÀY\n                            </label>\n                            <input class=\"mec-input\" data-kid=\"1-2-1-2-1-5-1-2\" data-name=\"date input field\" id=\"drive-date\" name=\"date\" type=\"date\"/>\n                        </div>\n                        <div class=\"mec-form-field\" data-kid=\"1-2-1-2-1-5-2\" data-name=\"time field container\">\n                            <label class=\"mec-form-label\" data-kid=\"1-2-1-2-1-5-2-1\" data-name=\"time field label\" for=\"drive-time\">\n                                GIỜ\n                            </label>\n                            <select class=\"mec-select\" data-kid=\"1-2-1-2-1-5-2-2\" data-name=\"time select menu\" id=\"drive-time\" name=\"time\">\n                                <option data-kid=\"1-2-1-2-1-5-2-2-1\" data-name=\"09:00 option\">\n                                    09:00\n                                </option>\n                                <option data-kid=\"1-2-1-2-1-5-2-2-2\" data-name=\"11:00 option\">\n                                    11:00\n                                </option>\n                                <option data-kid=\"1-2-1-2-1-5-2-2-3\" data-name=\"14:00 option\">\n                                    14:00\n                                </option>\n                                <option data-kid=\"1-2-1-2-1-5-2-2-4\" data-name=\"16:00 option\">\n                                    16:00\n                                </option>\n                            </select>\n                        </div>\n                    </div>\n                    <button class=\"mec-submit\" data-kid=\"1-2-1-2-1-6\" data-name=\"submit form button\" type=\"button\">\n                        <span data-kid=\"1-2-1-2-1-6-1\" data-name=\"submit button text\">\n                            GỬI YÊU CẦU LÁI THỬ\n                        </span>\n                        <i aria-hidden=\"true\" class=\"fa-solid fa-arrow-right\" data-kid=\"1-2-1-2-1-6-2\" data-name=\"right arrow icon\">\n                        </i>\n                    </button>\n                    <p class=\"mec-form-note\" data-kid=\"1-2-1-2-1-7\" data-name=\"form notice text\">\n                        Tư vấn viên sẽ liên hệ xác nhận lịch và địa điểm trước buổi lái thử.\n                    </p>\n                </form>\n                <aside aria-label=\"Các kênh liên hệ chưa khả dụng\" class=\"mec-contact-rail\" data-kid=\"1-2-1-2-2\" data-name=\"contact rail sidebar\">\n                    <h2 class=\"mec-contact-question\" data-kid=\"1-2-1-2-2-1\" data-name=\"rail headline\">\n                        Cần hỏi trước khi đặt lịch?\n                    </h2>\n                    <p class=\"mec-contact-context\" data-kid=\"1-2-1-2-2-2\" data-name=\"rail context\">\n                        Các kênh liên hệ riêng của MECDEX.\n                    </p>\n                    <div class=\"mec-contact-list\" data-kid=\"1-2-1-2-2-3\" data-name=\"contact methods list\">\n                        <div aria-disabled=\"true\" class=\"mec-contact-row\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"whatsapp list item\">\n                            <span class=\"mec-contact-icon\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"whatsapp icon container\">\n                                <i aria-hidden=\"true\" class=\"fa-brands fa-whatsapp\" data-kid=\"1-2-1-2-2-3-1-1-1\" data-name=\"whatsapp brand icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"whatsapp label container\">\n                                <span class=\"mec-contact-name\" data-kid=\"1-2-1-2-2-3-1-2-1\" data-name=\"whatsapp label text\">\n                                    WhatsApp\n                                </span>\n                                <span class=\"mec-contact-status\" data-kid=\"1-2-1-2-2-3-1-2-2\" data-name=\"whatsapp status text\">\n                                    Chưa có đường dẫn\n                                </span>\n                            </span>\n                        </div>\n                        <div aria-disabled=\"true\" class=\"mec-contact-row\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"twitter list item\">\n                            <span class=\"mec-contact-icon\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"twitter icon container\">\n                                <i aria-hidden=\"true\" class=\"fa-brands fa-x-twitter\" data-kid=\"1-2-1-2-2-3-2-1-1\" data-name=\"twitter brand icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"twitter label container\">\n                                <span class=\"mec-contact-name\" data-kid=\"1-2-1-2-2-3-2-2-1\" data-name=\"twitter label text\">\n                                    X\n                                </span>\n                                <span class=\"mec-contact-status\" data-kid=\"1-2-1-2-2-3-2-2-2\" data-name=\"twitter status text\">\n                                    Chưa có đường dẫn\n                                </span>\n                            </span>\n                        </div>\n                        <div aria-disabled=\"true\" class=\"mec-contact-row\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"telegram list item\">\n                            <span class=\"mec-contact-icon\" data-kid=\"1-2-1-2-2-3-3-1\" data-name=\"telegram icon container\">\n                                <i aria-hidden=\"true\" class=\"fa-brands fa-telegram\" data-kid=\"1-2-1-2-2-3-3-1-1\" data-name=\"telegram brand icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-2-1-2-2-3-3-2\" data-name=\"telegram label container\">\n                                <span class=\"mec-contact-name\" data-kid=\"1-2-1-2-2-3-3-2-1\" data-name=\"telegram label text\">\n                                    Telegram\n                                </span>\n                                <span class=\"mec-contact-status\" data-kid=\"1-2-1-2-2-3-3-2-2\" data-name=\"telegram status text\">\n                                    Chưa có đường dẫn\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"mec-contact-note\" data-kid=\"1-2-1-2-2-4\" data-name=\"rail note text\">\n                        Liên kết chính thức sẽ được bổ sung sau.\n                    </p>\n                </aside>\n            </div>\n        </section>\n    </main>\n    <div class=\"mec-audio-presence\" data-kid=\"1-3\" data-name=\"audio presence indicator\">\n        SCENE AUDIO\n        <strong data-kid=\"1-3-1\" data-name=\"audio status label\">\n            READY\n        </strong>\n    </div>\n</div>\n",
