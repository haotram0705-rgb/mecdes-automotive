      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n.mecdex-screen{min-height:100vh;background:#070809;color:#f2f2ef;font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.site-nav{height:80px;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;border-bottom:1px solid rgba(255,255,255,.1);background:linear-gradient(#070809ee,transparent);position:relative;z-index:2}\n.brand{font:700 24px 'Space Grotesk';letter-spacing:-1px;color:#f2f2ef;text-decoration:none}.brand b{color:#d9ff3f}\n.nav-links{display:flex;gap:34px;margin-left:90px}.nav-links a{font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#b8bcc0;text-decoration:none}.nav-links a.active{color:#d9ff3f}\n.compare{position:absolute;right:18px;top:96px;border:1px solid #ffffff20;border-radius:999px;background:#080a0bcc;padding:11px 17px;color:#e5e8e6;font-size:9px;letter-spacing:.14em}.compare b{color:#d9ff3f;margin-left:9px}\n.main-layout{width:min(1220px,calc(100% - 96px));margin:0 auto;padding:110px 0 140px;display:grid;grid-template-columns:minmax(360px,.94fr) minmax(0,1.46fr);gap:88px;align-items:start}\n.intro{padding-top:7px}.intro p{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#d9ff3f;margin:0 0 22px}.intro h1{font:600 clamp(82px,8vw,112px)/.84 'Space Grotesk';letter-spacing:-.075em;margin:0;max-width:500px}.intro .summary{font-size:14px;letter-spacing:0;text-transform:none;line-height:1.7;color:#92999c;margin:38px 0 0;max-width:350px}\n.booking-cluster{display:grid;grid-template-columns:minmax(0,1fr) 192px;gap:23px;align-items:end}.booking-form{min-width:0}.field{margin:0 0 19px}.field label{display:block;color:#777f84;font-size:9px;letter-spacing:.2em;text-transform:uppercase;margin:0 0 9px}.field input,.field select{display:block;width:100%;height:50px;padding:0 15px;border:1px solid #2c3136;border-radius:0;background:#101315;color:#e2e4e2;font:400 14px 'Inter';outline:none}.field input::placeholder{color:#798085}.field input:focus,.field select:focus{border-color:#697078}.date-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.submit{height:48px;width:100%;border:0;border-radius:0;background:#d9ff3f;color:#070809;padding:0 18px;display:flex;align-items:center;justify-content:space-between;font:600 10px 'Inter';letter-spacing:.17em;text-transform:uppercase}.submit span{font-size:18px;line-height:1}.form-note{font-size:9px;line-height:1.5;text-align:center;color:#686e72;margin:10px 0 0}\n.contact-aside{align-self:end;border-left:1px solid #292e31;padding:4px 0 30px 20px;margin-bottom:0}.contact-aside h2{font:600 16px/1.35 'Space Grotesk';letter-spacing:-.02em;color:#f2f2ef;margin:0 0 9px}.contact-aside .note{font-size:10px;line-height:1.6;color:#858d90;margin:0 0 18px}.social-list{display:grid;gap:0}.social-item{padding:11px 0 12px;border-top:1px solid #212629;display:grid;grid-template-columns:20px minmax(0,1fr);column-gap:8px;align-items:start;color:#c8cdca}.social-item .icon{font-size:15px;line-height:19px;color:#bbc1bd;text-align:center}.social-item .name{font:600 12px 'Space Grotesk';color:#e2e5e2}.social-item .destination{display:block;font-size:8px;line-height:1.4;color:#737b7f;margin-top:4px;letter-spacing:.01em}\n.scene-audio{position:absolute;left:22px;bottom:20px;padding:11px 15px;border:1px solid #ffffff22;border-radius:999px;background:#080a0bcc;color:#c8ceca;font-size:8px;letter-spacing:.17em}.scene-audio b{color:#d9ff3f;margin-left:7px}\n@media(max-width:1120px){.main-layout{grid-template-columns:1fr;gap:44px;max-width:680px;padding-top:96px}.intro h1{max-width:560px}.intro .summary{margin-top:23px}.booking-cluster{grid-template-columns:minmax(0,1fr) 210px}}\n@media(max-width:760px){.site-nav{height:68px;padding:0 20px}.nav-links{display:none}.compare{display:none}.main-layout{width:calc(100% - 40px);padding:76px 0 88px;gap:34px}.intro p{font-size:9px;margin-bottom:18px}.intro h1{font-size:clamp(64px,15vw,86px)}.intro .summary{font-size:13px;margin-top:21px}.booking-cluster{display:flex;flex-direction:column;align-items:stretch;gap:29px}.booking-form{order:1}.contact-aside{order:2;border-left:0;border-top:1px solid #292e31;padding:20px 0 0;margin:0}.contact-aside h2{font-size:16px}.contact-aside .note{max-width:430px;margin-bottom:12px}.social-list{grid-template-columns:repeat(3,minmax(0,1fr));column-gap:12px}.social-item{border-top:0;padding:8px 0;grid-template-columns:18px minmax(0,1fr);column-gap:6px}.social-item .name{font-size:11px}.social-item .icon{font-size:14px}.social-item .destination{font-size:8px}.scene-audio{left:12px;bottom:12px;font-size:7px}}\n@media(max-width:420px){.date-row{gap:8px}.field input,.field select{height:47px;padding:0 12px;font-size:13px}.social-list{column-gap:7px}.social-item{grid-template-columns:16px minmax(0,1fr);column-gap:4px}.social-item .name{font-size:10px}.social-item .destination{font-size:7px}}\n</style>\n<div class=\"mecdex-screen\" data-kid=\"1\" data-name=\"main layout screen container\">\n    <header class=\"site-nav\" data-kid=\"1-1\" data-name=\"site navigation header\">\n        <a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity logo link\" href=\"#top\">\n            MECDEX\n            <b data-kid=\"1-1-1-1\" data-name=\"brand logo decoration\">\n                .\n            </b>\n        </a>\n        <nav aria-label=\"Điều hướng chính\" class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <a data-kid=\"1-1-2-1\" data-name=\"about navigation link\" href=\"#about\">\n                About\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"models navigation link\" href=\"#models\">\n                Models\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"configurator navigation link\" href=\"#configurator\">\n                Configurator\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"360 studio navigation link\" href=\"#studio\">\n                360° Studio\n            </a>\n            <a class=\"active\" data-kid=\"1-1-2-5\" data-name=\"active test drive navigation link\" href=\"#drive\">\n                Test Drive\n            </a>\n        </nav>\n    </header>\n    <div class=\"compare\" data-kid=\"1-2\" data-name=\"compare module\">\n        COMPARE\n        <b data-kid=\"1-2-1\" data-name=\"compare count indicator\">\n            0\n        </b>\n    </div>\n    <main class=\"main-layout\" data-kid=\"1-3\" data-name=\"main page layout\" id=\"top\">\n        <section aria-labelledby=\"drive-heading\" class=\"intro\" data-kid=\"1-3-1\" data-name=\"intro section\">\n            <p data-kid=\"1-3-1-1\" data-name=\"intro section label\">\n                04 / EXPERIENCE IT\n            </p>\n            <h1 data-kid=\"1-3-1-2\" data-name=\"hero section heading\" id=\"drive-heading\">\n                Take the\n                <br data-kid=\"1-3-1-2-1\" data-name=\"heading line break\"/>\n                wheel.\n            </h1>\n            <p class=\"summary\" data-kid=\"1-3-1-3\" data-name=\"intro section summary text\">\n                Đặt lịch lái thử riêng tại showroom MECDEX.\n            </p>\n        </section>\n        <div class=\"booking-cluster\" data-kid=\"1-3-2\" data-name=\"booking module\">\n            <form aria-label=\"Yêu cầu lái thử\" class=\"booking-form\" data-kid=\"1-3-2-1\" data-name=\"test drive booking form\">\n                <div class=\"field\" data-kid=\"1-3-2-1-1\" data-name=\"full name field container\">\n                    <label data-kid=\"1-3-2-1-1-1\" data-name=\"full name label\" for=\"drive-name\">\n                        HỌ VÀ TÊN\n                    </label>\n                    <input autocomplete=\"name\" data-kid=\"1-3-2-1-1-2\" data-name=\"full name input field\" id=\"drive-name\" name=\"name\" placeholder=\"Nguyễn Văn A\"/>\n                </div>\n                <div class=\"field\" data-kid=\"1-3-2-1-2\" data-name=\"phone number field container\">\n                    <label data-kid=\"1-3-2-1-2-1\" data-name=\"phone number label\" for=\"drive-phone\">\n                        SỐ ĐIỆN THOẠI\n                    </label>\n                    <input autocomplete=\"tel\" data-kid=\"1-3-2-1-2-2\" data-name=\"phone number input field\" id=\"drive-phone\" inputmode=\"tel\" name=\"phone\" type=\"tel\"/>\n                </div>\n                <div class=\"field\" data-kid=\"1-3-2-1-3\" data-name=\"car model field container\">\n                    <label data-kid=\"1-3-2-1-3-1\" data-name=\"car model label\" for=\"drive-model\">\n                        MẪU XE\n                    </label>\n                    <select data-kid=\"1-3-2-1-3-2\" data-name=\"car model select dropdown\" id=\"drive-model\" name=\"model\">\n                        <option data-kid=\"1-3-2-1-3-2-1\" data-name=\"car model option apex x1\">\n                            APEX X1\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-2\" data-name=\"car model option veloce r\">\n                            VELOCE R\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-3\" data-name=\"car model option noir gt\">\n                            NOIR GT\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-4\" data-name=\"car model option c-class\">\n                            C-Class\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-5\" data-name=\"car model option e-class\">\n                            E-Class\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-6\" data-name=\"car model option s-class\">\n                            S-Class\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-7\" data-name=\"car model option eqs saloon\">\n                            EQS Saloon\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-8\" data-name=\"car model option glc\">\n                            GLC\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-9\" data-name=\"car model option gle\">\n                            GLE\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-10\" data-name=\"car model option gls\">\n                            GLS\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-11\" data-name=\"car model option g-class\">\n                            G-Class\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-12\" data-name=\"car model option amg gt coupe\">\n                            AMG GT Coupé\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-13\" data-name=\"car model option macan\">\n                            Macan\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-14\" data-name=\"car model option macan s\">\n                            Macan S\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-15\" data-name=\"car model option macan gts\">\n                            Macan GTS\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-16\" data-name=\"car model option 718 cayman\">\n                            718 Cayman\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-17\" data-name=\"car model option taycan\">\n                            Taycan\n                        </option>\n                        <option data-kid=\"1-3-2-1-3-2-18\" data-name=\"car model option 911 spirit 70\">\n                            911 Spirit 70\n                        </option>\n                    </select>\n                </div>\n                <div class=\"field\" data-kid=\"1-3-2-1-4\" data-name=\"showroom field container\">\n                    <label data-kid=\"1-3-2-1-4-1\" data-name=\"showroom label\" for=\"drive-showroom\">\n                        SHOWROOM\n                    </label>\n                    <select data-kid=\"1-3-2-1-4-2\" data-name=\"showroom select dropdown\" id=\"drive-showroom\" name=\"showroom\">\n                        <option data-kid=\"1-3-2-1-4-2-1\" data-name=\"showroom option ho chi minh\">\n                            TP. Hồ Chí Minh\n                        </option>\n                        <option data-kid=\"1-3-2-1-4-2-2\" data-name=\"showroom option ha noi\">\n                            Hà Nội\n                        </option>\n                    </select>\n                </div>\n                <div class=\"date-row\" data-kid=\"1-3-2-1-5\" data-name=\"date and time selection row\">\n                    <div class=\"field\" data-kid=\"1-3-2-1-5-1\" data-name=\"date field container\">\n                        <label data-kid=\"1-3-2-1-5-1-1\" data-name=\"date label\" for=\"drive-date\">\n                            NGÀY\n                        </label>\n                        <input data-kid=\"1-3-2-1-5-1-2\" data-name=\"date input field\" id=\"drive-date\" name=\"date\" type=\"date\"/>\n                    </div>\n                    <div class=\"field\" data-kid=\"1-3-2-1-5-2\" data-name=\"time field container\">\n                        <label data-kid=\"1-3-2-1-5-2-1\" data-name=\"time label\" for=\"drive-time\">\n                            GIỜ\n                        </label>\n                        <select data-kid=\"1-3-2-1-5-2-2\" data-name=\"time select dropdown\" id=\"drive-time\" name=\"time\">\n                            <option data-kid=\"1-3-2-1-5-2-2-1\" data-name=\"time option 0900\">\n                                09:00\n                            </option>\n                            <option data-kid=\"1-3-2-1-5-2-2-2\" data-name=\"time option 1100\">\n                                11:00\n                            </option>\n                            <option data-kid=\"1-3-2-1-5-2-2-3\" data-name=\"time option 1400\">\n                                14:00\n                            </option>\n                            <option data-kid=\"1-3-2-1-5-2-2-4\" data-name=\"time option 1600\">\n                                16:00\n                            </option>\n                        </select>\n                    </div>\n                </div>\n                <button class=\"submit\" data-kid=\"1-3-2-1-6\" data-name=\"submit form button\" type=\"button\">\n                    GỬI YÊU CẦU LÁI THỬ\n                    <span aria-hidden=\"true\" data-kid=\"1-3-2-1-6-1\" data-name=\"submit button arrow icon\">\n                        →\n                    </span>\n                </button>\n                <p class=\"form-note\" data-kid=\"1-3-2-1-7\" data-name=\"form submission note\">\n                    Tư vấn viên sẽ liên hệ xác nhận lịch và địa điểm trước buổi lái thử.\n                </p>\n            </form>\n            <aside aria-labelledby=\"contact-heading\" class=\"contact-aside\" data-kid=\"1-3-2-2\" data-name=\"contact information section\">\n                <h2 data-kid=\"1-3-2-2-1\" data-name=\"contact section heading\" id=\"contact-heading\">\n                    Muốn trao đổi trước khi gửi?\n                </h2>\n                <p class=\"note\" data-kid=\"1-3-2-2-2\" data-name=\"contact information note\">\n                    Các kênh liên hệ sẽ mở khi MECDEX cung cấp tài khoản chính thức.\n                </p>\n                <div class=\"social-list\" data-kid=\"1-3-2-2-3\" data-name=\"social media list\">\n                    <div class=\"social-item\" data-kid=\"1-3-2-2-3-1\" data-name=\"whatsapp contact item\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-whatsapp icon\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"whatsapp icon\">\n                        </i>\n                        <div data-kid=\"1-3-2-2-3-1-2\" data-name=\"whatsapp contact details container\">\n                            <span class=\"name\" data-kid=\"1-3-2-2-3-1-2-1\" data-name=\"whatsapp name\">\n                                WhatsApp\n                            </span>\n                            <span class=\"destination\" data-kid=\"1-3-2-2-3-1-2-2\" data-name=\"whatsapp destination link text\">\n                                Chưa có đường dẫn\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"social-item\" data-kid=\"1-3-2-2-3-2\" data-name=\"x contact item\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-x-twitter icon\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"x icon\">\n                        </i>\n                        <div data-kid=\"1-3-2-2-3-2-2\" data-name=\"x contact details container\">\n                            <span class=\"name\" data-kid=\"1-3-2-2-3-2-2-1\" data-name=\"x name\">\n                                X\n                            </span>\n                            <span class=\"destination\" data-kid=\"1-3-2-2-3-2-2-2\" data-name=\"x destination link text\">\n                                Chưa có đường dẫn\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"social-item\" data-kid=\"1-3-2-2-3-3\" data-name=\"telegram contact item\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-telegram icon\" data-kid=\"1-3-2-2-3-3-1\" data-name=\"telegram icon\">\n                        </i>\n                        <div data-kid=\"1-3-2-2-3-3-2\" data-name=\"telegram contact details container\">\n                            <span class=\"name\" data-kid=\"1-3-2-2-3-3-2-1\" data-name=\"telegram name\">\n                                Telegram\n                            </span>\n                            <span class=\"destination\" data-kid=\"1-3-2-2-3-3-2-2\" data-name=\"telegram destination link text\">\n                                Chưa có đường dẫn\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </main>\n    <div class=\"scene-audio\" data-kid=\"1-4\" data-name=\"scene audio indicator\">\n        SCENE AUDIO\n        <b data-kid=\"1-4-1\" data-name=\"scene audio status text\">\n            READY\n        </b>\n    </div>\n</div>\n",
